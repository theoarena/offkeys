# Extra keys arrive as hidraw. The mapper still opens only devices listed
# in config. Keyboard and mouse interfaces are skipped in software.
#
# After install: sudo udevadm control --reload && sudo udevadm trigger -s hidraw
# Then unplug/replug the receiver if permissions did not change.

SUBSYSTEM=="hidraw", KERNEL=="hidraw*", GROUP="plugdev", MODE="0660", TAG+="uaccess"

KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
